  year    = {2022},
  doi     = {10.1016/j.smrv.2022.101592},
}
% notes: Review that joins the two halves of C557 explicitly -- LC-NE in sleep-wake regulation, and what its degeneration implies for aging and Alzheimer's disease. The best single citation for the replacement paragraph, and closer to the thesis's framing than any of the pure-neuropathology entries.

@article{vanegroo2021awakenings,
  author  = {Van Egroo, Maxime and van Hooren, Roy W. E. and Jacobs, Heidi I. L.},
  title   = {Associations between locus coeruleus integrity and nocturnal awakenings in the context of {Alzheimer's} disease plasma biomarkers: a 7{T} {MRI} study},
