  doi     = {10.1093/sleep/zsag090},
}
% notes: PSG study of 28 long-COVID, 19 ME/CFS and 28 matched controls that extracts infra-slow oscillation relative band power (ISO, 0.005-0.03 Hz) among its microstructure measures, and reports widespread elevated ISO power in the slow sigma band (11-13 Hz) in ME/CFS. The most explicit published instance of infra-slow-oscillation-of-sigma-power measured in a clinical population outside aging and cognitive impairment, and notably an INCREASE where the schizophrenia and aging findings are decreases. Cite in the Discussion paragraph on ISFS/ISO outside aging and MCI.

% =====================================================================
% Locus coeruleus degeneration in aging and neurodegeneration (Yuval C557)
% =====================================================================

@article{mather2016locuscoeruleus,
  author  = {Mather, Mara and Harley, Carolyn W.},
  title   = {The Locus Coeruleus: Essential for Maintaining Cognitive Function and the Aging Brain},
  journal = {Trends in Cognitive Sciences},
  volume  = {20},
  number  = {3},
  pages   = {214--226},
  year    = {2016},
  doi     = {10.1016/j.tics.2016.01.001},
}
% notes: Review of locus-coeruleus function, its vulnerability in aging, and the cognitive-reserve argument for why LC integrity matters. Cite in the Discussion as the framing reference for the LC-degeneration replacement of the current cholinergic/REM passage (C557).

@article{braak2011stages,
  author  = {Braak, Heiko and Thal, Dietmar R. and Ghebremedhin, Estifanos and Del Tredici, Kelly},
  title   = {Stages of the Pathologic Process in {Alzheimer} Disease: Age Categories From 1 to 100 Years},
  journal = {Journal of Neuropathology \& Experimental Neurology},
  volume  = {70},
  number  = {11},
  pages   = {960--969},
  year    = {2011},
  doi     = {10.1097/NEN.0b013e318232a379},
}
% notes: Primary neuropathological series (2332 brains) establishing that abnormal tau appears in the locus coeruleus before the entorhinal cortex, often in young adulthood. The evidence that makes LC degeneration the earliest, not a late, event -- essential to the C557 rewrite and useful in the Introduction's neurodegeneration paragraph.

@article{dahl2019rostrallc,
  author  = {Dahl, Martin J. and Mather, Mara and Düzel, Sandra and Bodammer, Nils C. and Lindenberger, Ulman and Kühn, Simone and Werkle-Bergner, Markus},
  title   = {Rostral locus coeruleus integrity is associated with better memory performance in older adults},
