  volume  = {3},
  number  = {11},
  pages   = {1203--1214},
  year    = {2019},
  doi     = {10.1038/s41562-019-0715-2},
}
% notes: Primary in-vivo human MRI evidence linking locus-coeruleus integrity to memory in older adults. Cite in the Discussion to close the LC argument in humans rather than leaving it entirely on rodent work.

@article{osorioforero2022locuscoeruleus,
  author  = {Osorio-Forero, Alejandro and Cherrad, Najma and Banterle, Lila and Fernandez, Laura M. J. and Lüthi, Anita},
  title   = {When the Locus Coeruleus Speaks Up in Sleep: Recent Insights, Emerging Perspectives},
  journal = {International Journal of Molecular Sciences},
  volume  = {23},
  number  = {9},
  pages   = {5028},
  year    = {2022},
  doi     = {10.3390/ijms23095028},
}
% notes: Review dedicated to what the locus coeruleus does during sleep, including its infra-slow activity patterns and the argument that small alterations in LC function are consequential in sleep disorders. The published counterpart to the lab review Yuval offered via Noa R. (C557); usable now, and complementary rather than redundant once that one arrives.

@article{luthi2025microarousals,
  author  = {Lüthi, Anita and Nedergaard, Maiken},
  title   = {Anything but small: Microarousals stand at the crossroad between noradrenaline signaling and key sleep functions},
  journal = {Neuron},
  volume  = {113},
  number  = {4},
  pages   = {509--523},
  year    = {2025},
  doi     = {10.1016/j.neuron.2024.12.009},
}
% notes: Review proposing an inverted-U account in which NREM benefits depend on the amplitude of infra-slow noradrenergic fluctuations, and stating that weakened noradrenergic fluctuations occur in neurodegenerative disease and with sleep aids. The most directly citable statement that neurodegeneration blunts the infra-slow noradrenergic rhythm -- central to the C557 rewrite of the Discussion mechanism paragraph.

@article{hauglund2025vasomotion,
  author  = {Hauglund, Natalie L. and Andersen, Mie and Tokarska, Klaudia and Radovanovic, Tessa and Kjaerby, Celia and Sørensen, Frederikke L. and Bojarowska, Zuzanna and Untiet, Verena and Ballestero, Sheyla B. and Kolmos, Mie G. and Weikop, Pia and Hirase, Hajime and Nedergaard, Maiken},
  title   = {Norepinephrine-mediated slow vasomotion drives glymphatic clearance during sleep},
  journal = {Cell},
  volume  = {188},
  number  = {3},
  pages   = {606--622},
  year    = {2025},
  doi     = {10.1016/j.cell.2024.11.027},
}
% notes: Primary rodent work identifying synchronized infra-slow oscillations in norepinephrine, cerebral blood volume and CSF as the strongest predictors of glymphatic clearance during NREM, with locus-coeruleus optogenetics and a zolpidem manipulation establishing causality. The mechanistic bridge between the infra-slow noradrenergic rhythm this thesis measures indirectly and the clearance account of AD -- cite in the Discussion, including where grollero2026iso's glymphatic argument is engaged.

@article{kjaerby2026neuromodulators,
  author  = {Kjaerby, Celia and Radovanovic, Tessa and Kovács, Eszter Rebeka and Bojarowska, Zuzanna and Tokarska, Klaudia Anna and Tsopanidou, Anastasia and Nielsen, Elise Schiøler and Andersen, Mie and Li, Yulong and Weikop, Pia and Untiet, Verena and Nedergaard, Maiken},
  title   = {Coordinated infraslow cortical oscillations of neuromodulators during {NREM} sleep},
  journal = {iScience},
  volume  = {29},
  number  = {2},
  pages   = {114554},
  year    = {2026},
  doi     = {10.1016/j.isci.2025.114554},
}
% notes: Primary fiber-photometry work showing that acetylcholine, serotonin, dopamine, histamine and norepinephrine all oscillate on a synchronized infra-slow timescale during NREM, and that silencing the locus coeruleus abolishes the NE oscillation and selectively reduces the cholinergic one. Useful in two ways: it broadens the neuromodulatory account beyond noradrenaline, and it gives a principled way to keep acetylcholine in the Discussion -- as an NREM infra-slow signal under LC control, rather than via the REM/cholinergic argument Yuval called out as out of context (C557).

@article{poe2020locuscoeruleus,
  author  = {Poe, Gina R. and Foote, Stephen and Eschenko, Oxana and Johansen, Joshua P. and Bouret, Sebastien and Aston-Jones, Gary and Harley, Carolyn W. and Manahan-Vaughan, Denise and Weinshenker, David and Valentino, Rita and Berridge, Craig and Chandler, Daniel J. and Waterhouse, Barry and Sara, Susan J.},
  title   = {Locus coeruleus: a new look at the blue spot},
  journal = {Nature Reviews Neuroscience},
  volume  = {21},
  number  = {11},
  pages   = {644--659},
  year    = {2020},
  doi     = {10.1038/s41583-020-0360-9},
}
% notes: The standard consensus review of locus-coeruleus organization and function, authored by most of the field. Cite in the Discussion when the LC is first introduced as a structure rather than only as the pacemaker of the infra-slow rhythm.

@article{matchett2021vulnerability,
  author  = {Matchett, Billie J. and Grinberg, Lea T. and Theofilas, Panos and Murray, Melissa E.},
  title   = {The mechanistic link between selective vulnerability of the locus coeruleus and neurodegeneration in {Alzheimer's} disease},
  journal = {Acta Neuropathologica},
  volume  = {141},
  number  = {5},
  pages   = {631--650},
  year    = {2021},
  doi     = {10.1007/s00401-020-02248-1},
}
% notes: The dedicated review of WHY the locus coeruleus is selectively vulnerable in Alzheimer's disease. The central framing citation for the C557 rewrite: it is the paper that turns "the LC degenerates" into a mechanism rather than an observation.

@article{theofilas2017stereology,
  author  = {Theofilas, Panos and Ehrenberg, Alexander J. and Dunlop, Sara and Di Lorenzo Alho, Ana T. and Nguy, Austin and Leite, Renata Elaine Paraizo and Rodriguez, Roberta Diehl and Mejia, Maria B. and Suemoto, Claudia K. and Ferretti-Rebustini, Renata Eloah De Lucena and Polichiso, Livia and Nascimento, Camila F. and Seeley, William W. and Nitrini, Ricardo and Pasqualucci, Carlos Augusto and Jacob Filho, Wilson and Rueb, Udo and Neuhaus, John and Heinsen, Helmut and Grinberg, Lea T.},
  title   = {Locus coeruleus volume and cell population changes during {Alzheimer's} disease progression: A stereological study in human postmortem brains with potential implication for early-stage biomarker discovery},
  journal = {Alzheimer's \& Dementia},
  volume  = {13},
  number  = {3},
  pages   = {236--246},
  year    = {2017},
  doi     = {10.1016/j.jalz.2016.06.2362},
}
% notes: Primary stereological quantification of locus-coeruleus neuron loss across Braak stages in human postmortem brain. The hard numbers behind the claim that LC degeneration begins early and progresses with disease stage. Pairs with braak2011stages (which establishes the LC as the first site of tau) to make the early-and-progressive case.

@article{zarow2003neuronalloss,
  author  = {Zarow, Chris and Lyness, Scott A. and Mortimer, James A. and Chui, Helena C.},
  title   = {Neuronal Loss Is Greater in the Locus Coeruleus Than Nucleus Basalis and Substantia Nigra in {Alzheimer} and {Parkinson} Diseases},
  journal = {Archives of Neurology},
  volume  = {60},
  number  = {3},
  pages   = {337--341},
  year    = {2003},
  doi     = {10.1001/archneur.60.3.337},
}
% notes: Primary postmortem comparison showing locus-coeruleus neuron loss EXCEEDS that of the cholinergic nucleus basalis and of the substantia nigra in both AD and PD. Directly justifies Yuval's C557 instruction to lead with LC rather than with the cholinergic basal forebrain (schmitz2018cholinergic) -- it is the quantitative reason the emphasis should shift.

@article{weinshenker2018noradrenergic,
  author  = {Weinshenker, David},
  title   = {Long Road to Ruin: Noradrenergic Dysfunction in Neurodegenerative Disease},
  journal = {Trends in Neurosciences},
  volume  = {41},
  number  = {4},
  pages   = {211--223},
  year    = {2018},
  doi     = {10.1016/j.tins.2018.01.010},
}
% notes: Review of noradrenergic dysfunction across neurodegenerative diseases, arguing the LC is an early and causally relevant locus rather than collateral damage. Cite alongside matchett2021vulnerability in the Discussion.

@article{galgani2023locuscoeruleus,
  author  = {Galgani, Alessandro and Lombardo, Francesco and Martini, Nicola and Vergallo, Andrea and Bastiani, Luca and Hampel, Harald and Hlavata, Hana and Baldacci, Filippo and Tognoni, Gloria and De Marchi, Daniele and Ghicopulos, Irene and De Cori, Sara and Biagioni, Francesca and Busceti, Carla Letizia and Ceravolo, Roberto and Bonuccelli, Ubaldo and Chiappino, Dante and Siciliano, Gabriele and Fornai, Francesco and Pavese, Nicola and Giorgi, Filippo Sean},
  title   = {Magnetic resonance imaging locus coeruleus abnormality in amnestic {Mild Cognitive Impairment} is associated with future progression to dementia},
