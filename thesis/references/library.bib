  number  = {1},
  pages   = {32--46},
  year    = {2023},
  doi     = {10.1111/ene.15556},
}
% notes: The single most useful new reference of this batch, because it serves BOTH of Yuval's comments at once. In-vivo LC MRI measured specifically in AMNESTIC MCI, where LC abnormality predicts which patients later progress to dementia. For C557 it puts LC degeneration in exactly this thesis's population; for C571 it shows that aMCI is a heterogeneous group whose members can be separated by a biological marker into progressors and non-progressors -- which is precisely the point that aMCI is not uniformly early AD.

@article{vanegroo2022sleepwake,
  author  = {Van Egroo, Maxime and Koshmanova, Ekaterina and Vandewalle, Gilles and Jacobs, Heidi I. L.},
