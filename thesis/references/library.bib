  number  = {1},
  pages   = {159},
  year    = {2021},
  doi     = {10.1186/s13195-021-00902-8},
}
% notes: Primary in-vivo human evidence linking locus-coeruleus integrity (7T MRI) to disrupted sleep continuity, in the context of AD plasma biomarkers. This is the human LC-and-sleep result the Discussion needs so the LC argument is not carried entirely by rodent work; complements dahl2019rostrallc (LC integrity and memory) with a sleep outcome.

@article{teng2025synchrony,
  author  = {Teng, Sasa and Maldonado Rodriguez, Angie N. and Wang, Ruizhi and Chen, Xinyue and Peng, Yueqing},
  title   = {Synchrony of neuromodulatory systems during {NREM} sleep},
  journal = {Proceedings of the National Academy of Sciences},
